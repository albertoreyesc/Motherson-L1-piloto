# Ejemplo para el contenedor del piloto; NO contiene credenciales operativas.
Pilot__Enabled=true
MVP_SQL_TRANSACCIONAL=true
MVP_ADMIN_V2=true
MVP_AZURE_SERVER=motherson-piloto-l1-20261119.database.windows.net
MVP_BASE_COMPARTIDA=Motherson_L1
ConnectionStrings__Sql=Server=tcp:motherson-piloto-l1-20261119.database.windows.net,1433;Database=Motherson_L1;User ID=<usuario-restringido>;Password=<secreto-privado>;Encrypt=True;TrustServerCertificate=False
PowerBI__Mode=UserOwnsData
MVP_POWERBI_URL=<enlace-privado-del-informe-autorizado>
AllowedHosts=<nombre-del-host>
# Persistencia de claves/certificado: completar según MANUAL_DE_INSTALACION.md.
# DatosSimulados es una marca visual, no convierte ni limpia datos.
DatosSimulados=true
