createOrReplace

	expression ServidorSQL = "motherson-l1-equipo.database.windows.net" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

	expression BaseSQL = "Motherson_L1" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

	table ESTACION

		column id_estacion
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: id_estacion

		column id_linea
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: id_linea

		column nombre_estacion
			dataType: string
			summarizeBy: none
			sourceColumn: nombre_estacion

		column Linea = "Línea " & ESTACION[id_linea]
			dataType: string
			summarizeBy: none

		column Estacion = "L" & ESTACION[id_linea] & " · " & ESTACION[nombre_estacion]
			dataType: string
			summarizeBy: none

		partition ESTACION = m
			mode: import
			source =
					let
						Origen = Sql.Database(ServidorSQL, BaseSQL),
						Tabla = Origen{[Schema = "dbo", Item = "ESTACION"]}[Data],
						Final = Table.SelectColumns(Tabla, {"id_estacion", "id_linea", "nombre_estacion"})
					in
						Final

	table COLOR

		column id_color
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: id_color

		column nombre
			dataType: string
			summarizeBy: none
			sourceColumn: nombre

		partition COLOR = m
			mode: import
			source =
					let
						Origen = Sql.Database(ServidorSQL, BaseSQL),
						Tabla = Origen{[Schema = "dbo", Item = "COLOR"]}[Data],
						Final = Table.SelectColumns(Tabla, {"id_color", "nombre"})
					in
						Final

	table PUESTO_LOGISTICO

		column id_puesto
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: id_puesto

		column Nombre
			dataType: string
			summarizeBy: none
			sourceColumn: Nombre

		column Tipo
			dataType: string
			summarizeBy: none
			sourceColumn: Tipo

		column Personal = IF ( ISBLANK ( PUESTO_LOGISTICO[Tipo] ) || PUESTO_LOGISTICO[Tipo] = "", PUESTO_LOGISTICO[Nombre], PUESTO_LOGISTICO[Nombre] & " (" & PUESTO_LOGISTICO[Tipo] & ")" )
			dataType: string
			summarizeBy: none

		partition PUESTO_LOGISTICO = m
			mode: import
			source =
					let
						Origen = Sql.Database(ServidorSQL, BaseSQL),
						Tabla = Origen{[Schema = "dbo", Item = "PUESTO_LOGISTICO"]}[Data],
						Final = Table.SelectColumns(Tabla, {"id_puesto", "Nombre", "Tipo"})
					in
						Final

	table TURNO

		column id_turno
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: id_turno

		column nombre_turno
			dataType: string
			summarizeBy: none
			sourceColumn: nombre_turno

		column hora_inicio
			dataType: dateTime
			formatString: hh:nn
			summarizeBy: none
			sourceColumn: hora_inicio

		column hora_fin
			dataType: dateTime
			formatString: hh:nn
			summarizeBy: none
			sourceColumn: hora_fin

		column 'Minutos Turno' = ROUND ( ( TURNO[hora_fin] - TURNO[hora_inicio] ) * 1440, 0 )
			dataType: double
			formatString: 0
			summarizeBy: sum

		partition TURNO = m
			mode: import
			source =
					let
						Origen = Sql.Database(ServidorSQL, BaseSQL),
						Tabla = Origen{[Schema = "dbo", Item = "TURNO"]}[Data],
						Final = Table.SelectColumns(Tabla, {"id_turno", "nombre_turno", "hora_inicio", "hora_fin"})
					in
						Final

	table ESTANTERIA

		column id_estanteria
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: id_estanteria

		column id_estacion
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: id_estacion

		column estanteria
			dataType: string
			summarizeBy: none
			sourceColumn: estanteria

		column nivel
			dataType: string
			summarizeBy: none
			sourceColumn: nivel

		column cajas_estanteria
			dataType: int64
			formatString: #,0
			summarizeBy: sum
			sourceColumn: cajas_estanteria

		column Rack = RELATED ( ESTACION[Estacion] ) & " · Est. " & ESTANTERIA[estanteria]
			dataType: string
			summarizeBy: none

		partition ESTANTERIA = m
			mode: import
			source =
					let
						Origen = Sql.Database(ServidorSQL, BaseSQL),
						Tabla = Origen{[Schema = "dbo", Item = "ESTANTERIA"]}[Data],
						Final = Table.SelectColumns(Tabla, {"id_estanteria", "id_estacion", "estanteria", "nivel", "cajas_estanteria"})
					in
						Final

	table MATERIAL

		column numero_parte
			dataType: string
			summarizeBy: none
			sourceColumn: numero_parte

		column id_puesto
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: id_puesto

		column id_color
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: id_color

		column descripcion
			dataType: string
			summarizeBy: none
			sourceColumn: descripcion

		column uso
			dataType: string
			summarizeBy: none
			sourceColumn: uso

		column cantidad_por_caja
			dataType: int64
			formatString: #,0
			summarizeBy: none
			sourceColumn: cantidad_por_caja

		column stock
			dataType: int64
			formatString: #,0
			summarizeBy: none
			sourceColumn: stock

		column minimo
			dataType: int64
			formatString: #,0
			summarizeBy: none
			sourceColumn: minimo

		column 'Descripcion Mostrar' = VAR _d = IF ( ISBLANK ( MATERIAL[descripcion] ) || MATERIAL[descripcion] = "", "Sin descripción documental", MATERIAL[descripcion] ) RETURN UPPER ( LEFT ( _d, 1 ) ) & LOWER ( MID ( _d, 2, 300 ) )
			dataType: string
			summarizeBy: none

		column 'Tipo de uso' = IF ( ISBLANK ( MATERIAL[uso] ) || MATERIAL[uso] = "", "Sin dato", UPPER ( LEFT ( MATERIAL[uso], 1 ) ) & LOWER ( MID ( MATERIAL[uso], 2, 100 ) ) )
			dataType: string
			summarizeBy: none

		column 'Existencia (pzas)' = SUMX ( FILTER ( UBICACION, UBICACION[numero_parte] = MATERIAL[numero_parte] ), UBICACION[cantidad] ) + 0
			dataType: int64
			formatString: #,0
			summarizeBy: sum

		column Estado = VAR _e = MATERIAL[Existencia (pzas)] VAR _m = MATERIAL[minimo] RETURN IF ( _m <= 0, BLANK (), SWITCH ( TRUE (), _e = 0, "Agotado", _e <= _m, "Crítico", _e <= _m * 1.2, "Advertencia", "Normal" ) )
			dataType: string
			summarizeBy: none

		measure 'Materiales Evaluados' = DISTINCTCOUNT ( UBICACION[numero_parte] ) + 0
			formatString: #,0
			displayFolder: Hoja 3 · Capacidad

		measure 'Materiales Por Estado' = DISTINCTCOUNT ( UBICACION[numero_parte] )
			formatString: #,0
			displayFolder: Hoja 3 · Capacidad

		measure 'Disponibilidad Nota' = FORMAT ( [Materiales Evaluados], "#,0" ) & " materiales evaluados · existencia de planta vs. mínimo"
			displayFolder: Hoja 3 · Capacidad

		partition MATERIAL = m
			mode: import
			source =
					let
						Origen = Sql.Database(ServidorSQL, BaseSQL),
						Tabla = Origen{[Schema = "dbo", Item = "MATERIAL"]}[Data],
						Final = Table.SelectColumns(Tabla, {"numero_parte", "id_puesto", "id_color", "descripcion", "uso", "cantidad_por_caja", "stock", "minimo"})
					in
						Final

	table UBICACION

		column id_ubicacion
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: id_ubicacion

		column numero_parte
			dataType: string
			summarizeBy: none
			sourceColumn: numero_parte

		column id_estanteria
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: id_estanteria

		column cantidad
			dataType: int64
			formatString: #,0
			summarizeBy: sum
			sourceColumn: cantidad

		column Descripcion = RELATED ( MATERIAL[Descripcion Mostrar] )
			dataType: string
			summarizeBy: none

		column Pieza = UBICACION[Descripcion] & UNICHAR ( 10 ) & UBICACION[numero_parte]
			dataType: string
			summarizeBy: none

		column nombre_estacion = RELATED ( ESTACION[nombre_estacion] )
			dataType: string
			summarizeBy: none

		column Estacion = RELATED ( ESTACION[Estacion] )
			dataType: string
			summarizeBy: none

		column Estanteria = RELATED ( ESTANTERIA[estanteria] )
			dataType: string
			summarizeBy: none

		column 'Nivel Estante' = VAR _n = RELATED ( ESTANTERIA[nivel] ) RETURN IF ( ISBLANK ( _n ) || TRIM ( _n ) = "", "s/n", _n )
			dataType: string
			summarizeBy: none

		column Color = VAR _c = RELATED ( COLOR[nombre] ) RETURN IF ( ISBLANK ( _c ), "Sin color", _c )
			dataType: string
			summarizeBy: none

		column Puesto = VAR _t = LOOKUPVALUE ( PUESTO_LOGISTICO[Nombre], PUESTO_LOGISTICO[id_puesto], RELATED ( MATERIAL[id_puesto] ) ) RETURN IF ( ISBLANK ( _t ), "Sin puesto", _t )
			dataType: string
			summarizeBy: none

		column 'Capacidad (pzas)' = RELATED ( ESTANTERIA[cajas_estanteria] ) * RELATED ( MATERIAL[cantidad_por_caja] )
			dataType: int64
			formatString: #,0
			summarizeBy: sum

		column 'Minimo (pzas)' = RELATED ( MATERIAL[minimo] )
			dataType: int64
			formatString: #,0
			summarizeBy: sum

		column 'Ritmo (pzas/min)' = VAR _corte = MAX ( REGISTRO[fecha_hora_fin] ) VAR _desde = _corte - 28 VAR _ventana = FILTER ( REGISTRO, REGISTRO[fecha_hora_inicio] > _desde && REGISTRO[fecha_hora_inicio] <= _corte ) VAR _dias = COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( _ventana, "@dia", INT ( REGISTRO[fecha_hora_inicio] ) ) ) ) VAR _minutosDia = SUMX ( TURNO, TURNO[Minutos Turno] ) VAR _surtidos = COUNTROWS ( FILTER ( _ventana, REGISTRO[id_ubicacion] = UBICACION[id_ubicacion] ) ) VAR _lote = MAX ( UBICACION[Capacidad (pzas)] - UBICACION[Minimo (pzas)], RELATED ( MATERIAL[cantidad_por_caja] ) ) RETURN DIVIDE ( _surtidos * _lote, _dias * _minutosDia )
			dataType: double
			formatString: 0.000
			summarizeBy: none

		column 'Cobertura (min)' = DIVIDE ( UBICACION[cantidad], UBICACION[Ritmo (pzas/min)] )
			dataType: double
			formatString: 0
			summarizeBy: none

		measure 'Margen Advertencia' = 0.20
			formatString: 0%
			displayFolder: Parámetros

		measure 'Piezas Restantes' = SUM ( UBICACION[cantidad] )
			formatString: #,0
			displayFolder: Hoja 1 · Material restante

		measure 'Capacidad Piezas' = SUM ( UBICACION[Capacidad (pzas)] )
			formatString: #,0
			displayFolder: Hoja 1 · Material restante

		measure 'Minimo Piezas' = SUM ( UBICACION[Minimo (pzas)] )
			formatString: #,0
			displayFolder: Hoja 1 · Material restante

		measure '% Restante' = DIVIDE ( [Piezas Restantes], [Capacidad Piezas] )
			formatString: 0%
			displayFolder: Hoja 1 · Material restante

		measure '% Restante Barra' = [% Restante]
			formatString: 0%
			displayFolder: Hoja 1 · Material restante

		measure 'Materiales Monitoreados' = COUNTROWS ( UBICACION ) + 0
			formatString: #,0
			displayFolder: Hoja 1 · Material restante

		measure 'Cobertura Minutos' = MIN ( UBICACION[Cobertura (min)] )
			formatString: 0
			displayFolder: Hoja 1 · Material restante

		measure Nivel =
				VAR _p = [Piezas Restantes]
				VAR _m = [Minimo Piezas]
				RETURN
					IF (
						ISBLANK ( _p ) || ISBLANK ( _m ),
						BLANK (),
						SWITCH (
							TRUE (),
							_p = 0, "Agotado",
							_p <= _m, "Crítico",
							_p <= _m * ( 1 + [Margen Advertencia] ), "Advertencia",
							"Normal"
						)
					)
			displayFolder: Hoja 1 · Material restante

		measure 'Color Nivel' = SWITCH ( [Nivel], "Agotado", "#8F1D25", "Crítico", "#D92227", "Advertencia", "#EACD11", "Normal", "#8AB490" )
			displayFolder: Hoja 1 · Material restante

		measure 'Fondo Nivel' = SWITCH ( [Nivel], "Agotado", "#8F1D25", "Crítico", "#FDE2E3", "Advertencia", "#FFF6C6", "Normal", "#E3F0E5" )
			displayFolder: Hoja 1 · Material restante

		measure 'Texto Nivel' = SWITCH ( [Nivel], "Agotado", "#FFFFFF", "Crítico", "#8F1D25", "Advertencia", "#6B5A08", "Normal", "#3C5D40" )
			displayFolder: Hoja 1 · Material restante

		measure 'Piezas En Linea' = [Piezas Restantes]
			formatString: #,0
			displayFolder: Hoja 1 · Material restante

		measure 'Piezas En Linea Nota' = "En " & FORMAT ( [Materiales Monitoreados], "#,0" ) & " materiales monitoreados"
			displayFolder: Hoja 1 · Material restante

		measure 'Materiales Nivel Critico' = COUNTROWS ( FILTER ( VALUES ( UBICACION[id_ubicacion] ), [Nivel] IN { "Crítico", "Agotado" } ) ) + 0
			displayFolder: Hoja 1 · Material restante

		measure 'Materiales Nivel Bajo' = COUNTROWS ( FILTER ( VALUES ( UBICACION[id_ubicacion] ), [Nivel] = "Advertencia" ) ) + 0
			displayFolder: Hoja 1 · Material restante

		measure 'Materiales Nivel Normal' = COUNTROWS ( FILTER ( VALUES ( UBICACION[id_ubicacion] ), [Nivel] = "Normal" ) ) + 0
			displayFolder: Hoja 1 · Material restante

		measure 'Materiales En Riesgo' = [Materiales Nivel Critico] + [Materiales Nivel Bajo]
			displayFolder: Hoja 1 · Material restante

		measure 'Critico Nota' = "En su mínimo o por debajo · " & [Materiales Nivel Bajo] & " en advertencia"
			displayFolder: Hoja 1 · Material restante

		measure 'Cobertura Promedio Turno' = [% Restante]
			formatString: 0%
			displayFolder: Hoja 1 · Material restante

		measure 'Proximo Faltante Minutos' =
				MINX (
					FILTER ( VALUES ( UBICACION[id_ubicacion] ), [Piezas Restantes] > 0 ),
					[Cobertura Minutos]
				)
			formatString: 0 \m\i\n
			displayFolder: Hoja 1 · Material restante

		measure 'Proximo Faltante Detalle' =
				VAR _tabla =
					ADDCOLUMNS (
						FILTER ( VALUES ( UBICACION[id_ubicacion] ), [Piezas Restantes] > 0 && NOT ISBLANK ( [Cobertura Minutos] ) ),
						"@min", [Cobertura Minutos]
					)
				VAR _id = MAXX ( TOPN ( 1, _tabla, [@min], ASC ), UBICACION[id_ubicacion] )
				RETURN
					IF (
						NOT ISBLANK ( _id ),
						LOOKUPVALUE ( UBICACION[Descripcion], UBICACION[id_ubicacion], _id ) & " "
							& LOOKUPVALUE ( UBICACION[numero_parte], UBICACION[id_ubicacion], _id ) & " · "
							& LOOKUPVALUE ( UBICACION[nombre_estacion], UBICACION[id_ubicacion], _id )
					)
			displayFolder: Hoja 1 · Material restante

		measure 'Ultima Actualizacion Linea' =
				SELECTEDVALUE ( ESTACION[Linea], "Todas las líneas" ) & " · Última actualización "
					& FORMAT ( [Momento Corte], "dd/mm/yyyy hh:nn" )
			displayFolder: Hoja 1 · Material restante

		measure 'Cobertura Texto' =
				VAR _m = [Cobertura Minutos]
				RETURN IF ( ISBLANK ( _m ), BLANK (), FORMAT ( _m, "0" ) & " min" )
			displayFolder: Hoja 1 · Material restante

		measure 'Restante Texto' = FORMAT ( [Piezas Restantes], "#,0" ) & " / " & FORMAT ( [Capacidad Piezas], "#,0" )
			displayFolder: Hoja 1 · Material restante

		measure 'Proxima A Agotarse' = IF ( NOT ISBLANK ( [Cobertura Minutos] ) && [Cobertura Minutos] <= 60, 1, 0 )
			displayFolder: Hoja 1 · Material restante

		measure 'Subtitulo En Riesgo' = [Materiales En Riesgo] & " de " & [Materiales Monitoreados] & " en riesgo"
			displayFolder: Hoja 1 · Material restante

		measure 'Pct En Riesgo' = DIVIDE ( [Materiales En Riesgo], [Materiales Monitoreados] )
			formatString: 0%
			displayFolder: Hoja 1 · Material restante

		measure 'Riesgo Texto' = [Materiales En Riesgo] & " en riesgo · " & FORMAT ( [Pct En Riesgo], "0%" )
			displayFolder: Hoja 1 · Material restante

		measure 'Puesto Detalle' = FORMAT ( [Materiales Monitoreados], "#,0" ) & " materiales · " & FORMAT ( [Piezas Restantes], "#,0" ) & " pz"
			displayFolder: Hoja 1 · Material restante

		measure 'Color Detalle' = SELECTEDVALUE ( UBICACION[Color] ) & " · " & [Materiales Monitoreados] & " materiales"
			displayFolder: Hoja 1 · Material restante

		measure 'Color Riesgo' = IF ( [Materiales Nivel Critico] > 0, "#D92227", "#6B6B6B" )
			displayFolder: Hoja 1 · Material restante

		measure 'Existencia Piezas' = SUM ( UBICACION[cantidad] )
			formatString: #,0
			displayFolder: Hoja 3 · Capacidad

		measure 'Cajas Equivalentes' = SUMX ( UBICACION, DIVIDE ( UBICACION[cantidad], RELATED ( MATERIAL[cantidad_por_caja] ) ) )
			formatString: #,0
			displayFolder: Hoja 3 · Capacidad

		measure 'Cajas Equivalentes Nota' = "Existencia / piezas por caja, por posición"
			displayFolder: Hoja 3 · Capacidad

		measure 'Cajas Estimadas' = SUMX ( UBICACION, ROUNDUP ( DIVIDE ( UBICACION[cantidad], RELATED ( MATERIAL[cantidad_por_caja] ) ), 0 ) )
			formatString: #,0
			displayFolder: Hoja 3 · Capacidad

		measure 'Capacidad Cajas' = SUMX ( UBICACION, RELATED ( ESTANTERIA[cajas_estanteria] ) )
			formatString: #,0
			displayFolder: Hoja 3 · Capacidad

		measure '% Ocupacion' = DIVIDE ( [Cajas Estimadas], [Capacidad Cajas] )
			formatString: 0%
			displayFolder: Hoja 3 · Capacidad

		measure 'Color Ocupacion' =
				VAR _p = [% Ocupacion]
				RETURN SWITCH ( TRUE (), ISBLANK ( _p ), BLANK (), _p >= 0.85, "#D92227", _p >= 0.60, "#EACD11", "#8AB490" )
			displayFolder: Hoja 3 · Capacidad

		measure 'Ocupacion Nota' =
				VAR _r = FILTER ( ADDCOLUMNS ( VALUES ( ESTANTERIA[Rack] ), "@p", [% Ocupacion] ), NOT ISBLANK ( [@p] ) )
				RETURN
					FORMAT ( COUNTROWS ( FILTER ( _r, [@p] >= 0.85 ) ) + 0, "0" ) & " estanterías ≥ 85 % · "
						& FORMAT ( COUNTROWS ( FILTER ( _r, [@p] >= 0.6 && [@p] < 0.85 ) ) + 0, "0" ) & " entre 60 y 85 % · "
						& FORMAT ( COUNTROWS ( FILTER ( _r, [@p] < 0.6 ) ) + 0, "0" ) & " debajo de 60 %"
			displayFolder: Hoja 2 · Desempeño semanal

		partition UBICACION = m
			mode: import
			source =
					let
						Origen = Sql.Database(ServidorSQL, BaseSQL),
						Tabla = Origen{[Schema = "dbo", Item = "UBICACION"]}[Data],
						Final = Table.SelectColumns(Tabla, {"id_ubicacion", "numero_parte", "id_estanteria", "cantidad"})
					in
						Final

	table REGISTRO

		column id_registro
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: id_registro

		column id_puesto
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: id_puesto

		column id_ubicacion
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: id_ubicacion

		column id_turno
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: id_turno

		column fecha_hora_inicio
			dataType: dateTime
			formatString: dd/mm/yyyy hh:nn:ss
			summarizeBy: none
			sourceColumn: fecha_hora_inicio

		column fecha_hora_fin
			dataType: dateTime
			formatString: dd/mm/yyyy hh:nn:ss
			summarizeBy: none
			sourceColumn: fecha_hora_fin

		column intervalo_h
			dataType: double
			formatString: 0.00
			summarizeBy: none
			sourceColumn: intervalo_h

		column Fecha = DATE ( YEAR ( REGISTRO[fecha_hora_inicio] ), MONTH ( REGISTRO[fecha_hora_inicio] ), DAY ( REGISTRO[fecha_hora_inicio] ) )
			dataType: dateTime
			formatString: dd/mm/yyyy
			summarizeBy: none

		column 'Semana Indice' = INT ( ( REGISTRO[Fecha] - DATE ( 2000, 1, 3 ) ) / 7 )
			dataType: int64
			formatString: 0
			summarizeBy: none

		column Periodo = VAR _ini = REGISTRO[Fecha] - WEEKDAY ( REGISTRO[Fecha], 2 ) + 1 VAR _fin = _ini + 5 RETURN "S" & FORMAT ( WEEKNUM ( REGISTRO[Fecha], 21 ), "00" ) & " " & YEAR ( _ini + 3 ) & " · " & FORMAT ( DAY ( _ini ), "00" ) & "/" & FORMAT ( MONTH ( _ini ), "00" ) & " – " & FORMAT ( DAY ( _fin ), "00" ) & "/" & FORMAT ( MONTH ( _fin ), "00" )
			dataType: string
			summarizeBy: none
			sortByColumn: 'Semana Indice'

		column 'Dia Corto' = FORMAT ( DAY ( REGISTRO[Fecha] ), "00" ) & " " & SWITCH ( MONTH ( REGISTRO[Fecha] ), 1, "ene", 2, "feb", 3, "mar", 4, "abr", 5, "may", 6, "jun", 7, "jul", 8, "ago", 9, "sep", 10, "oct", 11, "nov", 12, "dic" ) & " " & RIGHT ( YEAR ( REGISTRO[Fecha] ), 2 )
			dataType: string
			summarizeBy: none
			sortByColumn: Fecha

		column Completado = IF ( NOT ISBLANK ( REGISTRO[fecha_hora_fin] ) && REGISTRO[fecha_hora_fin] >= REGISTRO[fecha_hora_inicio], 1, 0 )
			dataType: int64
			formatString: 0
			summarizeBy: sum

		column Minutos = IF ( REGISTRO[Completado] = 1, DATEDIFF ( REGISTRO[fecha_hora_inicio], REGISTRO[fecha_hora_fin], SECOND ) / 60 )
			dataType: double
			formatString: 0.0
			summarizeBy: none

		column Serie = RELATED ( UBICACION[numero_parte] ) & "|" & RELATED ( ESTANTERIA[id_estacion] )
			dataType: string
			summarizeBy: none

		measure 'Momento Corte' = CALCULATE ( MAX ( MAX ( REGISTRO[fecha_hora_fin] ), MAX ( REGISTRO[fecha_hora_inicio] ) ), REMOVEFILTERS () )
			formatString: dd/mm/yyyy hh:nn
			displayFolder: Parámetros

		measure 'Semana Seleccionada' =
				IF (
					HASONEFILTER ( REGISTRO[Periodo] ),
					VAR _p = MAXX ( FILTERS ( REGISTRO[Periodo] ), REGISTRO[Periodo] )
					RETURN CALCULATE ( MAX ( REGISTRO[Semana Indice] ), REMOVEFILTERS ( REGISTRO ), REGISTRO[Periodo] = _p )
				)
			formatString: 0
			displayFolder: Parámetros

		measure 'Umbral Horas Medio' = 8
			formatString: 0
			displayFolder: Parámetros

		measure 'Umbral Horas Alto' = 24
			formatString: 0
			displayFolder: Parámetros

		measure 'Umbral Repeticion Media' = 4
			formatString: 0
			displayFolder: Parámetros

		measure 'Umbral Repeticion Alta' = 10
			formatString: 0
			displayFolder: Parámetros

		measure 'Tiempo Objetivo Min' = 4.5
			formatString: 0.0
			displayFolder: Parámetros

		measure Reabastecimientos = COUNTROWS ( REGISTRO )
			formatString: #,0
			displayFolder: Hoja 2 · Actividad logística

		measure 'Reabast Completados' = CALCULATE ( COUNTROWS ( REGISTRO ), REGISTRO[Completado] = 1 ) + 0
			formatString: #,0
			displayFolder: Hoja 2 · Actividad logística

		measure 'Completados Dia' = CALCULATE ( COUNTROWS ( REGISTRO ), REGISTRO[Completado] = 1 )
			formatString: #,0
			displayFolder: Hoja 2 · Actividad logística

		measure 'Completados Anterior' =
				VAR _w = [Semana Seleccionada]
				RETURN
					IF (
						NOT ISBLANK ( _w ),
						CALCULATE (
							[Reabast Completados],
							REMOVEFILTERS ( REGISTRO[Periodo], REGISTRO[Semana Indice], REGISTRO[Fecha], REGISTRO[Dia Corto] ),
							REGISTRO[Semana Indice] = _w - 1
						)
					)
			formatString: #,0
			displayFolder: Hoja 2 · Actividad logística

		measure 'Completados Var Texto' =
				VAR _a = [Completados Anterior]
				VAR _v = IF ( _a > 0, DIVIDE ( [Reabast Completados] - _a, _a ) )
				RETURN
					IF (
						ISBLANK ( _v ),
						"Selecciona una semana para comparar con la anterior",
						IF ( _v >= 0, "▲ +", "▼ −" ) & FORMAT ( ABS ( _v ), "0.0%" ) & " vs. semana anterior"
					)
			displayFolder: Hoja 2 · Actividad logística

		measure 'Reabast En Curso' =
				CALCULATE (
					COUNTROWS ( REGISTRO ),
					REMOVEFILTERS ( REGISTRO[Periodo], REGISTRO[Semana Indice], REGISTRO[Fecha], REGISTRO[Dia Corto] ),
					ISBLANK ( REGISTRO[fecha_hora_fin] )
				) + 0
			formatString: #,0
			displayFolder: Hoja 2 · Actividad logística

		measure 'Reabast Repetidos' =
				SUMX (
					SUMMARIZE ( REGISTRO, REGISTRO[Fecha], REGISTRO[Serie] ),
					VAR _c = CALCULATE ( COUNTROWS ( REGISTRO ) )
					RETURN MAX ( _c - 1, 0 )
				)
			formatString: #,0
			displayFolder: Hoja 2 · Actividad logística

		measure 'Repetidos Total' = [Reabast Repetidos] + 0
			formatString: #,0
			displayFolder: Hoja 2 · Actividad logística

		measure 'Registros Incompletos' =
				CALCULATE (
					COUNTROWS ( REGISTRO ),
					FILTER ( REGISTRO, ISBLANK ( REGISTRO[id_puesto] ) || ISBLANK ( REGISTRO[id_ubicacion] ) )
				) + 0
			formatString: #,0
			displayFolder: Hoja 2 · Actividad logística

		measure 'Incompletos Nota' = FORMAT ( DIVIDE ( [Registros Incompletos], [Reabastecimientos] ) + 0, "0.0%" ) & " del total · sin personal o sin ubicación"
			displayFolder: Hoja 2 · Actividad logística

		measure 'Top 5 Personal' =
				VAR _r = [Reabastecimientos]
				RETURN
					IF ( NOT ISBLANK ( _r ) && RANKX ( ALLSELECTED ( PUESTO_LOGISTICO[Personal] ), [Reabastecimientos], , DESC ) <= 5, _r )
			formatString: #,0
			displayFolder: Hoja 2 · Actividad logística

		measure 'Top 5 Materiales' =
				VAR _r = [Reabastecimientos]
				RETURN
					IF ( NOT ISBLANK ( _r ) && RANKX ( ALLSELECTED ( MATERIAL[numero_parte] ), [Reabastecimientos], , DESC ) <= 5, _r )
			formatString: #,0
			displayFolder: Hoja 2 · Actividad logística

		measure 'Intervalo Promedio' = AVERAGE ( REGISTRO[intervalo_h] )
			formatString: 0.0
			displayFolder: Hoja 2 · Actividad logística

		measure 'Intervalo Texto' = IF ( ISBLANK ( [Intervalo Promedio] ), "—", FORMAT ( [Intervalo Promedio], "0.0" ) & " h" )
			displayFolder: Hoja 2 · Actividad logística

		measure 'Intervalo Anterior' =
				VAR _w = [Semana Seleccionada]
				RETURN
					IF (
						NOT ISBLANK ( _w ),
						CALCULATE (
							[Intervalo Promedio],
							REMOVEFILTERS ( REGISTRO[Periodo], REGISTRO[Semana Indice], REGISTRO[Fecha], REGISTRO[Dia Corto] ),
							REGISTRO[Semana Indice] = _w - 1
						)
					)
			formatString: 0.0
			displayFolder: Hoja 2 · Actividad logística

		measure 'Intervalo Var Texto' =
				VAR _a = [Intervalo Anterior]
				VAR _v = IF ( _a > 0, DIVIDE ( [Intervalo Promedio] - _a, _a ) )
				RETURN
					IF (
						ISBLANK ( _v ),
						"Selecciona una semana para comparar con la anterior",
						IF ( _v >= 0, "▲ +", "▼ −" ) & FORMAT ( ABS ( _v ), "0.0%" ) & " vs. semana anterior"
					)
			displayFolder: Hoja 2 · Actividad logística

		measure 'Referencia Periodo' =
				VAR _w = [Semana Seleccionada]
				VAR _c = [Momento Corte]
				VAR _f = DATE ( 2000, 1, 3 ) + 7 * ( _w + 1 )
				RETURN IF ( ISBLANK ( _w ) || _f > _c, _c, _f )
			formatString: dd/mm/yyyy hh:nn
			displayFolder: Hoja 2 · Actividad logística

		measure 'Ultimo Reabasto' =
				VAR _ref = [Referencia Periodo]
				RETURN
					CALCULATE (
						MAX ( REGISTRO[fecha_hora_fin] ),
						REMOVEFILTERS ( REGISTRO[Periodo], REGISTRO[Semana Indice], REGISTRO[Fecha], REGISTRO[Dia Corto] ),
						REGISTRO[Completado] = 1,
						REGISTRO[fecha_hora_fin] <= _ref
					)
			formatString: dd/mm hh:nn
			displayFolder: Hoja 2 · Actividad logística

		measure 'Horas Desde Ultimo' =
				VAR _u = [Ultimo Reabasto]
				RETURN IF ( NOT ISBLANK ( _u ), ( [Referencia Periodo] - _u ) * 24 )
			formatString: 0.0
			displayFolder: Hoja 2 · Actividad logística

		measure 'Fondo Horas' =
				VAR _h = [Horas Desde Ultimo]
				RETURN SWITCH ( TRUE (), ISBLANK ( _h ), BLANK (), _h >= [Umbral Horas Alto], "#FDE2E3", _h >= [Umbral Horas Medio], "#FFF6C6", "#FFFFFF" )
			displayFolder: Hoja 2 · Actividad logística

		measure 'Texto Horas' = IF ( [Horas Desde Ultimo] >= [Umbral Horas Alto], "#8F1D25", "#101010" )
			displayFolder: Hoja 2 · Actividad logística

		measure 'Repetidos Tabla' =
				VAR _r = [Reabast Repetidos]
				RETURN IF ( _r > 0, _r )
			formatString: #,0
			displayFolder: Hoja 2 · Actividad logística

		measure 'Max Reabast Dia' =
				IF (
					NOT ISBLANK ( [Repetidos Tabla] ),
					MAXX ( VALUES ( REGISTRO[Fecha] ), CALCULATE ( COUNTROWS ( REGISTRO ) ) )
				)
			formatString: #,0
			displayFolder: Hoja 2 · Actividad logística

		measure 'Fondo Max Dia' =
				VAR _m = [Max Reabast Dia]
				RETURN SWITCH ( TRUE (), ISBLANK ( _m ), BLANK (), _m >= [Umbral Repeticion Alta], "#FDE2E3", _m >= [Umbral Repeticion Media], "#FFF6C6", "#FFFFFF" )
			displayFolder: Hoja 2 · Actividad logística

		measure 'Texto Max Dia' = IF ( [Max Reabast Dia] >= [Umbral Repeticion Alta], "#8F1D25", "#101010" )
			displayFolder: Hoja 2 · Actividad logística

		measure 'Subtitulo Estado Actual' =
				"Eficiencia de los reabastecimientos y capacidad del flow rack · corte "
					& FORMAT ( [Momento Corte], "dd/mm/yyyy hh:nn" )
			displayFolder: Hoja 3 · Rendimiento logístico

		measure 'Tiempo Promedio Reabast' = AVERAGE ( REGISTRO[Minutos] )
			formatString: 0.0 \m\i\n
			displayFolder: Hoja 3 · Rendimiento logístico

		measure 'Tiempo P90 Reabast' =
				IF (
					[Reabast Completados] > 0,
					PERCENTILEX.INC ( FILTER ( REGISTRO, REGISTRO[Completado] = 1 ), REGISTRO[Minutos], 0.9 )
				)
			formatString: 0.0 \m\i\n
			displayFolder: Hoja 3 · Rendimiento logístico

		measure 'Reabast Fuera Objetivo' =
				VAR _objetivo = [Tiempo Objetivo Min]
				RETURN CALCULATE ( COUNTROWS ( REGISTRO ), REGISTRO[Minutos] > _objetivo ) + 0
			formatString: #,0
			displayFolder: Hoja 3 · Rendimiento logístico

		measure '% Fuera Objetivo' = DIVIDE ( [Reabast Fuera Objetivo], [Reabast Completados] ) + 0
			formatString: 0.0%
			displayFolder: Hoja 3 · Rendimiento logístico

		measure 'Tiempo Promedio Nota' = FORMAT ( [Reabast Completados], "#,0" ) & " reabastecimientos completados · de inicio a fin"
			displayFolder: Hoja 3 · Rendimiento logístico

		measure 'Tiempo P90 Nota' = "9 de cada 10 terminan antes · promedio " & FORMAT ( [Tiempo Promedio Reabast], "0.0" ) & " min"
			displayFolder: Hoja 3 · Rendimiento logístico

		measure 'Fuera Objetivo Nota' = FORMAT ( [Reabast Fuera Objetivo], "#,0" ) & " de más de " & FORMAT ( [Tiempo Objetivo Min], "0.0" ) & " min"
			displayFolder: Hoja 2 · Desempeño semanal

		measure 'Tiempo Acumulado Horas' = SUM ( REGISTRO[Minutos] ) / 60
			formatString: 0.0 \h
			displayFolder: Hoja 3 · Rendimiento logístico

		column 'Semana Corta' = VAR _ini = REGISTRO[Fecha] - WEEKDAY ( REGISTRO[Fecha], 2 ) + 1 RETURN "S" & FORMAT ( WEEKNUM ( REGISTRO[Fecha], 21 ), "00" ) & " " & RIGHT ( YEAR ( _ini + 3 ), 2 )
			dataType: string
			summarizeBy: none
			sortByColumn: 'Semana Indice'

		column Hora = HOUR ( REGISTRO[fecha_hora_inicio] )
			dataType: int64
			formatString: 00
			summarizeBy: none

		measure 'Minimo Surtidos Ranking' = 10
			formatString: 0
			displayFolder: Parámetros

		measure 'Umbral Semana Atipica' = 0.20
			formatString: 0%
			displayFolder: Parámetros

		measure 'Periodo Texto' =
				VAR _w = [Semana Seleccionada]
				VAR _c = [Momento Corte]
				VAR _corte = DATE ( YEAR ( _c ), MONTH ( _c ), DAY ( _c ) )
				VAR _ini = IF ( ISBLANK ( _w ), CALCULATE ( MIN ( REGISTRO[Fecha] ), REMOVEFILTERS ( REGISTRO ) ), DATE ( 2000, 1, 3 ) + 7 * _w )
				VAR _fin = IF ( ISBLANK ( _w ) || _ini + 6 > _corte, _corte, _ini + 6 )
				VAR _p = IF ( NOT ISBLANK ( _w ), MAXX ( FILTERS ( REGISTRO[Periodo] ), REGISTRO[Periodo] ) )
				RETURN
					"Reabastecimientos, cumplimiento del tiempo objetivo y capacidad · "
						& IF ( ISBLANK ( _p ), "Periodo: ", LEFT ( _p, SEARCH ( " ·", _p ) - 1 ) & ": " )
						& FORMAT ( _ini, "dd/mm/yyyy" ) & " – " & FORMAT ( _fin, "dd/mm/yyyy" )
			displayFolder: Hoja 2 · Desempeño semanal

		measure 'En Curso Nota' = "Al corte " & FORMAT ( [Momento Corte], "dd/mm hh:nn" ) & " · " & FORMAT ( [Registros Incompletos], "#,0" ) & " incompletos"
			displayFolder: Hoja 2 · Desempeño semanal

		measure 'Repetidos Nota' = FORMAT ( DIVIDE ( [Reabast Repetidos], [Reabastecimientos] ) + 0, "0.0%" ) & " del total"
			displayFolder: Hoja 2 · Desempeño semanal

		measure 'Tiempo Promedio P90 Nota' = "P90: " & FORMAT ( [Tiempo P90 Reabast], "0.0" ) & " min"
			displayFolder: Hoja 2 · Desempeño semanal

		measure 'Periodo Filtro Texto' =
				VAR _i = MIN ( REGISTRO[Fecha] )
				VAR _f = MAX ( REGISTRO[Fecha] )
				RETURN IF ( ISBLANK ( _i ), "sin datos", FORMAT ( _i, "dd/mm/yy" ) & " – " & FORMAT ( _f, "dd/mm/yy" ) )
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Diagnostico Subtitulo' = "Tendencias, rankings y propuesta de balanceo · periodo " & [Periodo Filtro Texto] & " · " & FORMAT ( [Reabast Completados], "#,0" ) & " surtidos completados"
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Horas Disponibles' =
				VAR _dias = CALCULATE ( DISTINCTCOUNT ( REGISTRO[Fecha] ), ALLEXCEPT ( REGISTRO, REGISTRO[Fecha], REGISTRO[Periodo], REGISTRO[Semana Indice], REGISTRO[Semana Corta], REGISTRO[Dia Corto] ) )
				VAR _minutos = SUMX ( ALL ( TURNO ), TURNO[Minutos Turno] )
				VAR _puestos = COUNTROWS ( VALUES ( PUESTO_LOGISTICO[id_puesto] ) )
				RETURN _dias * _minutos / 60 * _puestos
			formatString: #,0 \h
			displayFolder: Hoja 3 · Diagnóstico

		measure '% Ocupacion Puesto' = DIVIDE ( [Tiempo Acumulado Horas], [Horas Disponibles] )
			formatString: 0%
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Ordenes Por Hora' = DIVIDE ( [Reabast Completados], [Horas Disponibles] )
			formatString: 0.0
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Color Ocupacion Puesto' =
				VAR _p = [% Ocupacion Puesto]
				RETURN SWITCH ( TRUE (), ISBLANK ( _p ), BLANK (), _p >= 0.30, "#D92227", _p < 0.05, "#EACD11", "#9A9A9A" )
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Tiempo Material Elegible' = IF ( [Reabast Completados] >= [Minimo Surtidos Ranking], [Tiempo Promedio Reabast] )
			formatString: 0.0 \m\i\n
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Rank Lento Tiempo' =
				VAR _t = [Tiempo Material Elegible]
				RETURN
					IF (
						NOT ISBLANK ( _t ) && ISINSCOPE ( MATERIAL[numero_parte] ),
						VAR _r = RANKX ( FILTER ( ALLSELECTED ( MATERIAL ), NOT ISBLANK ( [Tiempo Material Elegible] ) ), [Tiempo Material Elegible], _t, DESC )
						RETURN IF ( _r <= 5, _t )
					)
			formatString: 0.0 \m\i\n
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Rank Lento Surtidos' = IF ( NOT ISBLANK ( [Rank Lento Tiempo] ), [Reabast Completados] )
			formatString: #,0
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Rank Rapido Tiempo' =
				VAR _t = [Tiempo Material Elegible]
				RETURN
					IF (
						NOT ISBLANK ( _t ) && ISINSCOPE ( MATERIAL[numero_parte] ),
						VAR _r = RANKX ( FILTER ( ALLSELECTED ( MATERIAL ), NOT ISBLANK ( [Tiempo Material Elegible] ) ), [Tiempo Material Elegible], _t, ASC )
						RETURN IF ( _r <= 5, _t )
					)
			formatString: 0.0 \m\i\n
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Rank Rapido Surtidos' = IF ( NOT ISBLANK ( [Rank Rapido Tiempo] ), [Reabast Completados] )
			formatString: #,0
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Turnos Nota' =
				VAR _tab = FILTER ( ADDCOLUMNS ( VALUES ( TURNO[nombre_turno] ), "@n", [Reabast Completados] ), [@n] > 0 )
				VAR _max = MAXX ( _tab, [@n] )
				VAR _min = MINX ( _tab, [@n] )
				VAR _dif = DIVIDE ( _max - _min, _min )
				VAR _top = MAXX ( TOPN ( 1, _tab, [@n], DESC ), TURNO[nombre_turno] )
				RETURN
					IF (
						COUNTROWS ( _tab ) < 2,
						"Selecciona los dos turnos para compararlos.",
						IF (
							_dif < 0.10,
							"Carga equilibrada: los turnos difieren " & FORMAT ( _dif, "0%" ) & " en surtidos.",
							_top & " atiende " & FORMAT ( _dif, "0%" ) & " más surtidos que el otro turno; revisar la asignación de rutas."
						)
					)
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Balanceo Nota' =
				VAR _tab = FILTER ( ADDCOLUMNS ( VALUES ( PUESTO_LOGISTICO[Nombre] ), "@o", [% Ocupacion Puesto] ), NOT ISBLANK ( [@o] ) )
				VAR _alto = MAXX ( TOPN ( 1, _tab, [@o], DESC ), PUESTO_LOGISTICO[Nombre] )
				VAR _bajo = MAXX ( TOPN ( 1, _tab, [@o], ASC ), PUESTO_LOGISTICO[Nombre] )
				RETURN IF ( COUNTROWS ( _tab ) >= 2, "Balanceo: " & _alto & " ocupa " & FORMAT ( MAXX ( _tab, [@o] ), "0%" ) & " y " & _bajo & " solo " & FORMAT ( MINX ( _tab, [@o] ), "0%" ) & "." )
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Balanceo Nota 2' = IF ( NOT ISBLANK ( [Balanceo Nota] ), "Repartiendo materiales, todos quedarían cerca de " & FORMAT ( [% Ocupacion Puesto], "0%" ) & " de ocupación." )
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Rec 1 Balanceo' =
				VAR _per = " · Periodo: " & [Periodo Filtro Texto]
				VAR _tot = [Reabast Completados]
				VAR _tab = ADDCOLUMNS ( VALUES ( PUESTO_LOGISTICO[Nombre] ), "@n", [Reabast Completados], "@o", [% Ocupacion Puesto] )
				VAR _top = TOPN ( 1, FILTER ( _tab, [@n] > 0 ), [@n], DESC )
				VAR _nom = MAXX ( _top, PUESTO_LOGISTICO[Nombre] )
				VAR _n = MAXX ( _top, [@n] )
				VAR _o = MAXX ( _top, [@o] )
				VAR _bajos = FILTER ( _tab, NOT ISBLANK ( [@o] ) && [@o] < 0.10 )
				VAR _lista = CONCATENATEX ( _bajos, PUESTO_LOGISTICO[Nombre], ", ", [@o], ASC )
				RETURN
					IF (
						_tot > 0,
						"1 · Balanceo de carga. " & _nom & " concentra el " & FORMAT ( DIVIDE ( _n, _tot ), "0%" ) & " de los surtidos (" & FORMAT ( _n, "#,0" ) & " de "
							& FORMAT ( _tot, "#,0" ) & ") y " & FORMAT ( _o, "0%" ) & " de ocupación"
							& IF ( COUNTROWS ( _bajos ) > 0, "; " & _lista & " quedan debajo de 10 % cada uno", "" )
							& ". → Evaluar pasar materiales de " & _nom & " a los puestos con menor carga." & _per
					)
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Rec 2 Material Lento' =
				VAR _per = " · Periodo: " & [Periodo Filtro Texto]
				VAR _tab = FILTER ( ADDCOLUMNS ( VALUES ( MATERIAL[numero_parte] ), "@t", [Tiempo Material Elegible] ), NOT ISBLANK ( [@t] ) )
				VAR _top = TOPN ( 1, _tab, [@t], DESC )
				VAR _np = MAXX ( _top, MATERIAL[numero_parte] )
				VAR _tm = MAXX ( _top, [@t] )
				VAR _prom = [Tiempo Promedio Reabast]
				VAR _desc = LOOKUPVALUE ( MATERIAL[Descripcion Mostrar], MATERIAL[numero_parte], _np )
				VAR _rep = CALCULATE ( [Reabast Repetidos], MATERIAL[numero_parte] = _np )
				RETURN
					IF (
						ISBLANK ( _np ),
						"2 · Material lento. Ningún material tiene al menos " & [Minimo Surtidos Ranking] & " surtidos completados en el periodo." & _per,
						"2 · Material lento. " & _desc & " " & _np & " tarda " & FORMAT ( _tm, "0.0" ) & " min en promedio (" & FORMAT ( DIVIDE ( _tm, _prom ), "0.0" )
							& "× el promedio de " & FORMAT ( _prom, "0.0" ) & " min)"
							& IF ( _rep > 0, " y tuvo " & FORMAT ( _rep, "#,0" ) & " surtidos repetidos en el mismo día", "" )
							& ". → Revisar su ruta y la capacidad de su estantería." & _per
					)
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Rec 3 Semana Atipica' =
				VAR _per = " · Periodo: " & [Periodo Filtro Texto]
				VAR _tab =
					ADDCOLUMNS (
						VALUES ( REGISTRO[Semana Indice] ),
						"@t", [Tiempo Promedio Reabast],
						"@prev",
							VAR _w = REGISTRO[Semana Indice]
							RETURN
								CALCULATE (
									[Tiempo Promedio Reabast],
									REMOVEFILTERS ( REGISTRO[Fecha], REGISTRO[Periodo], REGISTRO[Semana Indice], REGISTRO[Semana Corta], REGISTRO[Dia Corto] ),
									REGISTRO[Semana Indice] = _w - 1
								)
					)
				VAR _x = ADDCOLUMNS ( FILTER ( _tab, [@prev] > 0 && NOT ISBLANK ( [@t] ) ), "@d", DIVIDE ( [@t] - [@prev], [@prev] ) )
				VAR _top = TOPN ( 1, _x, [@d], DESC )
				VAR _w = MAXX ( _top, REGISTRO[Semana Indice] )
				VAR _d = MAXX ( _top, [@d] )
				VAR _t = MAXX ( _top, [@t] )
				VAR _p = MAXX ( _top, [@prev] )
				VAR _lbl = CALCULATE ( MAX ( REGISTRO[Semana Corta] ), REMOVEFILTERS ( REGISTRO ), REGISTRO[Semana Indice] = _w )
				RETURN
					IF (
						NOT ISBLANK ( _w ),
						IF (
							_d >= [Umbral Semana Atipica],
							"3 · Semana atípica. En " & _lbl & " el tiempo promedio subió a " & FORMAT ( _t, "0.0" ) & " min, " & FORMAT ( _d, "+0%;-0%" )
								& " contra la semana anterior (" & FORMAT ( _p, "0.0" ) & " min). → Revisar qué cambió esa semana (personal, ruta o material).",
							"3 · Tiempo estable. Ninguna semana subió más de " & FORMAT ( [Umbral Semana Atipica], "0%" ) & " contra la anterior; el mayor cambio fue "
								& FORMAT ( _d, "+0%;-0%" ) & " en " & _lbl & ". → Mantener la operación actual."
						) & _per
					)
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Rec 4 Riesgo' =
				VAR _n = [Materiales Nivel Critico]
				RETURN
					IF (
						_n = 0,
						"4 · Riesgo actual. Ningún material está en o por debajo de su mínimo. → Sin acción urgente.",
						"4 · Riesgo actual. " & _n & " materiales están en o por debajo de su mínimo; el de menor cobertura es " & [Proximo Faltante Detalle] & ", con "
							& FORMAT ( [Proximo Faltante Minutos], "0" ) & " min estimados. → Priorizar su surtido."
					) & " · Corte: " & FORMAT ( [Momento Corte], "dd/mm/yyyy hh:nn" )
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Rec 5 Horas Pico' =
				VAR _per = " · Periodo: " & [Periodo Filtro Texto]
				VAR _tab = FILTER ( ADDCOLUMNS ( VALUES ( REGISTRO[Hora] ), "@n", [Reabastecimientos] ), [@n] > 0 )
				VAR _nmax = MAXX ( _tab, [@n] )
				VAR _nmin = MINX ( _tab, [@n] )
				VAR _picos = FILTER ( _tab, [@n] = _nmax )
				VAR _hmax = CONCATENATEX ( _picos, FORMAT ( REGISTRO[Hora], "00" ) & ":00", " y ", REGISTRO[Hora], ASC )
				VAR _hmin = MINX ( FILTER ( _tab, [@n] = _nmin ), REGISTRO[Hora] )
				RETURN
					IF (
						NOT ISBLANK ( _nmax ),
						"5 · Horas pico. A las " & _hmax & " se inician " & FORMAT ( _nmax, "#,0" ) & " surtidos" & IF ( COUNTROWS ( _picos ) > 1, " en cada hora", "" )
							& ", " & FORMAT ( DIVIDE ( _nmax, _nmin ), "0.0" ) & "× más que a las " & FORMAT ( _hmin, "00" ) & ":00 (" & FORMAT ( _nmin, "#,0" )
							& "). → Asegurar personal completo en esas horas y no programar descansos ahí." & _per
					)
			displayFolder: Hoja 3 · Diagnóstico

		measure 'Rec 6 Turnos' =
				VAR _per = " · Periodo: " & [Periodo Filtro Texto]
				VAR _tab = FILTER ( ADDCOLUMNS ( VALUES ( TURNO[nombre_turno] ), "@n", [Reabast Completados], "@t", [Tiempo Promedio Reabast] ), [@n] > 0 )
				VAR _max = MAXX ( _tab, [@n] )
				VAR _min = MINX ( _tab, [@n] )
				VAR _dif = DIVIDE ( _max - _min, _min )
				VAR _top = MAXX ( TOPN ( 1, _tab, [@n], DESC ), TURNO[nombre_turno] )
				VAR _lista = CONCATENATEX ( _tab, TURNO[nombre_turno] & " atendió " & FORMAT ( [@n], "#,0" ) & " surtidos (" & FORMAT ( [@t], "0.0" ) & " min)", " y ", TURNO[nombre_turno], ASC )
				RETURN
					IF (
						COUNTROWS ( _tab ) >= 2,
						IF (
							_dif < 0.10,
							"6 · Turnos equilibrados. " & _lista & "; la diferencia es de " & FORMAT ( _dif, "0%" ) & ". → Mantener la asignación actual entre turnos.",
							"6 · Turnos desbalanceados. " & _lista & "; " & _top & " atiende " & FORMAT ( _dif, "0%" ) & " más. → Revisar la asignación de rutas entre turnos."
						) & _per
					)
			displayFolder: Hoja 3 · Diagnóstico

		partition REGISTRO = m
			mode: import
			source =
					let
						// La vista dbo.vw_registro_bi (script 05_indices_y_vista.sql) trae REGISTRO más intervalo_h:
						// horas desde el surtido anterior del mismo material en la misma estación
						Origen = Sql.Database(ServidorSQL, BaseSQL),
						Datos = Origen{[Schema = "dbo", Item = "vw_registro_bi"]}[Data]
					in
						Datos

	relationship REGISTRO_UBICACION
		fromColumn: REGISTRO.id_ubicacion
		toColumn: UBICACION.id_ubicacion

	relationship REGISTRO_PUESTO
		fromColumn: REGISTRO.id_puesto
		toColumn: PUESTO_LOGISTICO.id_puesto

	relationship REGISTRO_TURNO
		fromColumn: REGISTRO.id_turno
		toColumn: TURNO.id_turno

	relationship UBICACION_MATERIAL
		fromColumn: UBICACION.numero_parte
		toColumn: MATERIAL.numero_parte

	relationship UBICACION_ESTANTERIA
		fromColumn: UBICACION.id_estanteria
		toColumn: ESTANTERIA.id_estanteria

	relationship ESTANTERIA_ESTACION
		fromColumn: ESTANTERIA.id_estacion
		toColumn: ESTACION.id_estacion

	relationship MATERIAL_COLOR
		fromColumn: MATERIAL.id_color
		toColumn: COLOR.id_color

	relationship MATERIAL_PUESTO
		isActive: false
		fromColumn: MATERIAL.id_puesto
		toColumn: PUESTO_LOGISTICO.id_puesto
