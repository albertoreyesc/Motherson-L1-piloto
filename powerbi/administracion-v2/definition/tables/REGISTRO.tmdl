	column fecha_hora_fin
		dataType: dateTime
		formatString: dd/mm/yyyy hh:nn:ss
		lineageTag: 674431df-58c0-4ebb-8723-76727a9d4de4
		summarizeBy: none
		sourceColumn: fecha_hora_fin

	column Fecha = DATE ( YEAR ( REGISTRO[fecha_hora_inicio] ), MONTH ( REGISTRO[fecha_hora_inicio] ), DAY ( REGISTRO[fecha_hora_inicio] ) )
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: fc1a75e8-a860-4e73-b69e-d43714612942
		summarizeBy: none

	column 'Semana Indice' = INT ( ( REGISTRO[Fecha] - DATE ( 2000, 1, 3 ) ) / 7 )
		dataType: int64
		formatString: 0
		lineageTag: 8b690734-28e7-4ce7-8b93-1d4b12cbf171
		summarizeBy: none

	column Periodo =
			VAR _ini = REGISTRO[Fecha] - WEEKDAY ( REGISTRO[Fecha], 2 ) + 1
			VAR _fin = _ini + 5
			RETURN
				"S" & FORMAT ( WEEKNUM ( REGISTRO[Fecha], 21 ), "00" ) & " " & YEAR ( _ini + 3 ) & " · "
					& FORMAT ( DAY ( _ini ), "00" ) & "/" & FORMAT ( MONTH ( _ini ), "00" ) & " – "
					& FORMAT ( DAY ( _fin ), "00" ) & "/" & FORMAT ( MONTH ( _fin ), "00" )
		dataType: string
		lineageTag: bcd13835-3172-4b1e-81c9-b2f05596d6b2
		summarizeBy: none
		sortByColumn: 'Semana Indice'

	column 'Dia Corto' =
			FORMAT ( DAY ( REGISTRO[Fecha] ), "00" ) & " "
				& SWITCH ( MONTH ( REGISTRO[Fecha] ), 1, "ene", 2, "feb", 3, "mar", 4, "abr", 5, "may", 6, "jun", 7, "jul", 8, "ago", 9, "sep", 10, "oct", 11, "nov", 12, "dic" )
				& " " & RIGHT ( YEAR ( REGISTRO[Fecha] ), 2 )
		dataType: string
		lineageTag: 69e4a06f-8095-4299-8dea-669cb4bd9eb1
		summarizeBy: none
		sortByColumn: Fecha

	column Completado = IF ( NOT ISBLANK ( REGISTRO[fecha_hora_fin] ) && REGISTRO[fecha_hora_fin] >= REGISTRO[fecha_hora_inicio], 1, 0 )
		dataType: int64
		formatString: 0
		lineageTag: f30616ab-ba8f-4c2d-9de0-c64ab6870085
		summarizeBy: sum

	column Minutos = IF ( REGISTRO[Completado] = 1, DATEDIFF ( REGISTRO[fecha_hora_inicio], REGISTRO[fecha_hora_fin], SECOND ) / 60 )
		dataType: double
		formatString: 0.0
		lineageTag: 092b14b2-9713-40a1-9eea-67f0a0329a5e
		summarizeBy: none

	column Serie = RELATED ( UBICACION[numero_parte] ) & "|" & RELATED ( ESTANTERIA[id_estacion] )
		dataType: string
		lineageTag: 12c4525f-3d86-4493-984b-77b5338f70d4
		summarizeBy: none

	column intervalo_h
		dataType: double
		formatString: 0.00
		lineageTag: 2009642a-954a-42b9-a291-e8ed446c0dfc
		summarizeBy: none
		sourceColumn: intervalo_h

	column 'Semana Corta' = VAR _ini = REGISTRO[Fecha] - WEEKDAY ( REGISTRO[Fecha], 2 ) + 1 RETURN "S" & FORMAT ( WEEKNUM ( REGISTRO[Fecha], 21 ), "00" ) & " " & RIGHT ( YEAR ( _ini + 3 ), 2 )
		dataType: string
		lineageTag: 9859c3fa-68d1-4d23-9b8b-e96caf1130f8
		summarizeBy: none
		sortByColumn: 'Semana Indice'

	column Hora = HOUR ( REGISTRO[fecha_hora_inicio] )
		dataType: int64
		formatString: 00
