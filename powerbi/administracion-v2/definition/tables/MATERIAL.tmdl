	column uso
		dataType: string
		lineageTag: 598665e5-10fe-448b-8a37-22e2678f0d2b
		summarizeBy: none
		sourceColumn: uso

	column cantidad_por_caja
		dataType: int64
		formatString: #,0
		lineageTag: ab9bddbd-fc06-4446-86d6-50ec3ee07720
		summarizeBy: none
		sourceColumn: cantidad_por_caja

	column stock
		dataType: int64
		formatString: #,0
		lineageTag: bf47727d-a86f-413c-b96d-cf2d4dd496dc
		summarizeBy: none
		sourceColumn: stock

	column minimo
		dataType: int64
		formatString: #,0
		lineageTag: 5d49eca4-b9e5-46ee-b20f-8814e18d9996
		summarizeBy: none
		sourceColumn: minimo

	column 'Descripcion Mostrar' =
			VAR _d = IF ( ISBLANK ( MATERIAL[descripcion] ) || MATERIAL[descripcion] = "", "Sin descripción documental", MATERIAL[descripcion] )
			RETURN UPPER ( LEFT ( _d, 1 ) ) & LOWER ( MID ( _d, 2, 300 ) )
		dataType: string
		lineageTag: 122074e5-7b44-4ef5-8edc-8744ba42ab7f
		summarizeBy: none

	column 'Tipo de uso' =
			IF (
				ISBLANK ( MATERIAL[uso] ) || MATERIAL[uso] = "",
				"Sin dato",
				UPPER ( LEFT ( MATERIAL[uso], 1 ) ) & LOWER ( MID ( MATERIAL[uso], 2, 100 ) )
			)
		dataType: string
		lineageTag: 16f41570-a69c-4a60-9bbe-64a490713e37
		summarizeBy: none

	column 'Existencia (pzas)' = SUMX ( FILTER ( UBICACION, UBICACION[clave_material] = MATERIAL[clave_material] ), UBICACION[cantidad] ) + 0
		dataType: int64
		formatString: #,0
		lineageTag: 7983f648-5de3-416d-a279-665f77df3d42
		summarizeBy: sum

	column Estado =
			VAR _sitios = COUNTROWS ( FILTER ( UBICACION, UBICACION[clave_material] = MATERIAL[clave_material] ) )
			VAR _e = MATERIAL[Existencia (pzas)]
			VAR _m = MATERIAL[minimo]
			RETURN
				IF (
					_sitios = 0, "Sin ubicación",
				IF (
					_m <= 0,
					BLANK (),
					SWITCH ( TRUE (), _e = 0, "Agotado", _e <= _m, "Crítico", _e <= _m * 1.2, "Advertencia", "Normal" )
				))
		dataType: string
		lineageTag: 957881ed-d7b7-4a87-9018-f177d5139d15
		summarizeBy: none

	partition MATERIAL = m
		mode: import
		source =
				let
					Origen = Sql.Database(ServidorSQL, BaseSQL),
					Datos = Origen{[Schema = "mes2", Item = "bi_MATERIAL"]}[Data]
				in
					Datos

	column clave_material
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: clave_material

	column modelo
		dataType: string
		sourceColumn: modelo
		summarizeBy: none

	column revision
		dataType: string
		sourceColumn: revision
		summarizeBy: none

	column variante
		dataType: string
		sourceColumn: variante
		summarizeBy: none

	column activo
		dataType: boolean
		sourceColumn: activo
		summarizeBy: none

	column id_linea
		dataType: int64
		sourceColumn: id_linea
		summarizeBy: none

	column 'Modelo Vehiculo' = IF ( ISBLANK ( MATERIAL[modelo] ) || MATERIAL[modelo] = "", "Sin modelo documentado", MATERIAL[modelo] )
		dataType: string
		summarizeBy: none
