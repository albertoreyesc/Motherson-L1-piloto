{
  "name": "Motherson",
  "dataColors": [
    "#D92227",
    "#EACD11",
    "#8AB490",
    "#101010",
    "#6B6B6B",
    "#C9C9C9",
    "#8F1D25",
    "#3C5D40"
  ],
  "background": "#FFFFFF",
  "foreground": "#101010",
  "tableAccent": "#D92227",
  "good": "#8AB490",
  "neutral": "#EACD11",
  "bad": "#D92227",
  "maximum": "#8AB490",
  "center": "#EACD11",
  "minimum": "#D92227",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#101010"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#101010"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#4A4A4A"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 30,
      "color": "#101010"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E2E2"
              }
            },
            "radius": 4
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#101010"
              }
            },
            "fontSize": 14
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F3F3"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F3F3F3"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#4A4A4A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "grid": [
          {
            "rowPadding": 6,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EDEDED"
              }
            },
            "gridVertical": false
          }
        ]
      }
    }
  }
}
